#!/home/zongtai/miniconda3/envs/cl_cotnav/bin/python
"""
ROS 2 service node for Scene Understanding (Task 2.1).

Uses system Python 3.12 for rclpy, delegates ML inference
to conda Python via subprocess (scene_worker.py).
"""

import json
import os
import subprocess

import rclpy
from rclpy.node import Node

from dexmate_interfaces.srv import SceneUnderstanding

_WORKER = os.path.join(os.path.dirname(os.path.abspath(__file__)), "workers", "scene_worker.py")


class SceneUnderstandingNode(Node):
    def __init__(self):
        super().__init__("scene_understanding_node")

        self.declare_parameter("box_threshold", 0.25)
        self.declare_parameter("device", "cuda")

        self.box_threshold = self.get_parameter("box_threshold").value
        self.device = self.get_parameter("device").value

        self.srv = self.create_service(
            SceneUnderstanding, "scene_understanding", self.handle_request,
        )
        self.get_logger().info("Service /scene_understanding is up.")

    def handle_request(self, request, response):
        rgb_path = request.rgb_path
        depth_path = request.depth_path
        self.get_logger().info(f"Request: rgb={rgb_path}  depth={depth_path}")

        try:
            proc = subprocess.run(
                [_WORKER, rgb_path, depth_path,
                 str(self.box_threshold), str(self.device)],
                capture_output=True, text=True, timeout=120,
            )

            if proc.returncode != 0:
                response.success = False
                response.message = proc.stderr.strip() or "Worker failed"
                response.scene_json = "[]"
                response.raw_image_path = ""
                response.annotated_image_path = ""
                response.point_cloud_path = ""
                self.get_logger().error(f"Worker error: {response.message}")
                return response

            result = json.loads(proc.stdout)
            # Support both legacy (scene_json only) and new format
            if isinstance(result, list):
                scene_json = result
                response.raw_image_path = request.rgb_path
                response.annotated_image_path = ""
                response.point_cloud_path = ""
            else:
                scene_json = result.get("scene_json", [])
                response.raw_image_path = result.get("raw_image_path", request.rgb_path)
                response.annotated_image_path = result.get("annotated_image_path", "")
                response.point_cloud_path = result.get("point_cloud_path", "")

            response.scene_json = json.dumps(scene_json)
            response.success = True
            response.message = f"Detected {len(scene_json)} objects."
            self.get_logger().info(response.message)

        except subprocess.TimeoutExpired:
            response.success = False
            response.message = "Scene worker timed out (120s)"
            response.scene_json = "[]"
            response.raw_image_path = ""
            response.annotated_image_path = ""
            response.point_cloud_path = ""
        except Exception as e:
            response.success = False
            response.message = str(e)
            response.scene_json = "[]"
            response.raw_image_path = ""
            response.annotated_image_path = ""
            response.point_cloud_path = ""

        return response


def main(args=None):
    rclpy.init(args=args)
    node = SceneUnderstandingNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
